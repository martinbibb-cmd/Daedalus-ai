[Unit]
Description=Daedalus Platform manual queue bridge
After=network-online.target daedalus-manual-ripper.service
Wants=network-online.target
Requires=daedalus-manual-ripper.service

[Service]
Type=oneshot
User=manual-ripper
Group=manual-ripper
WorkingDirectory=/srv/daedalus/manual-ripper
EnvironmentFile=/etc/daedalus-manual-ripper.env
EnvironmentFile=/etc/daedalus-manual-ripper-bridge.env
ExecStart=/srv/daedalus/manual-ripper/.venv/bin/python /srv/daedalus/manual-ripper/bin/platform_queue_worker.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/daedalus/manuals /srv/daedalus/regressions
